# Copy this file to .env and fill in your own Firebase web config
# (Firebase console → Project settings → Your apps → SDK setup and configuration).
# Only the first four keys are required; the app warns at startup if one is missing.
VITE_FIREBASE_API_KEY="your-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Optional.
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional. Leave unset in development so requests go through the Vite proxy
# (/api → http://127.0.0.1:8000). Point it at the deployed API for production.
# VITE_API_BASE_URL="https://api.example.com"
