# ==============================================================================
# DataPulse - Comprehensive Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Cache Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Firebase Service Account Credentials & Tokens
*firebase-service-account*.json
*service-account*.json
firebase-credentials.json
bearer token/

# ------------------------------------------------------------------------------
# Databases & Local SQLite Backups
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
datapulse.db
backend/datapulse.db

# ------------------------------------------------------------------------------
# Uploaded & Temporary User Data
# ------------------------------------------------------------------------------
uploads/
backend/uploads/
*/uploads/*
!uploads/.gitkeep
!backend/uploads/.gitkeep
scratch/
tmp/
temp/

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
venv_*/
backend/venv/
backend/venv_*/

# Testing & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.eslintcache
*.tsbuildinfo

# Vite & Frontend Environment Overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# Logs & Process Outputs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDEs, Editors & AI Assistants
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.claude/
.gemini/
# Google/Firebase credentials
*-service-account*.json
serviceAccount*.json
google-credentials*.json
*.pem
