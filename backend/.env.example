PROJECT_NAME=DataPulse

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/datapulse

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Admin Service Account path (relative to app root or absolute)
FIREBASE_CREDENTIAL_PATH=app/firebase-service-account.json

# Upload Configuration
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=50
